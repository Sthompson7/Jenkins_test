pipeline {
    agent any
    environment {
      IMAGE_NAME = 'Sthompson7/Jenkins_test'
    }
    stages {
        stage('checkout'){
            steps {
                git branch: 'main',
                    url: 'https://github.com/Sthompson7/Jenkins_test.git'
            }
        }

        stage('build docker image'){
            steps {
                sh 'echo "docker build -t %IMAGE_NAME%:latest ."'
            }
        }

        stage('test') {
            steps {
                sh 'echo "running tests"'
            }
        }

        stage('push to dockerhub') {
            steps {
              withCredentials([usernamePassword])
            }
        }
    }
}
