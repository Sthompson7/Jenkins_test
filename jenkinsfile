pipeline{
  agent any
  stages{
    stage('checkout code'){
      steps{
        git branch: 'main', url: 'https://github.com/Sthompson7/Jenkins_test/jenkinsfile.git'
      }
    }
     stage('build'){
       steps{
         sh 'echo "building the app"'
       }
     }
     stage('test'){
       steps{
         sh 'running tests"'
       }
     }
     stage('deploy'){
       steps{
         sh 'echo "deploying"'
       }
     }
   } 
}
