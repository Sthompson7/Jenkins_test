pipeline {
    agent any
    stages {
        stage('checkout'){
            steps {
                git branch: 'main',
                    url: 'https://github.com/Sthompson7/Jenkins_test.git'
            }
        }

        stage('tag the image'){
            steps {
                scripts{
                  IMAGE_TAG = 'latest')
                 )
              }
         }

        stage('login to ECR') {
            steps {
              withAWS(region: "${env.AWS_REGION}", credentials: 'aws-creds'){
                powershell '''
                $password = aws ecr get-login-password --region ap-south-1
                docker login --username AWS --password $password 897531648956.dkr.ecr.ap-south-1.amazonaws.com
                '''
            }
          }
      }
      stage('build docker image){
       steps{
         powershell '''
         docker build -t test:django .
         docker tag test:django 897531648956.dkr.ecr.ap-south-1.amazonaws.com/test:django
                '''
        }
      }
      stage('push to ECR'){
       steps{
         powershell '''
         docker push 897531648956.dkr.ecr.ap-south-1.amazonaws.com/test:django
         '''
      }
    }
  }

}

