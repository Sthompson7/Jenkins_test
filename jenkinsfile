pipeline {
    agent any
    environment{
        VENV = 'venv'
    }
    stages {
        stage('checkout'){
            steps {
                git branch: 'main',
                    url: 'https://github.com/Sthompson7/Jenkins_test'
            }
        }
      stage('set up the venv'){
       steps{
        bat 'pythin -m venv %VENV%'
        bat '%VENV%\\Scripts\\python -m pip install --upgrade pip'
        bat '%VENV%\\Scripts\\pip install -r requirment.txt'
        }
      }
      stage('RUN THE TESTS'){
       steps{
          bat '%VENV%\\Scripts\\python -m unnittest discover -s tests'
        }
     }
  }
}

