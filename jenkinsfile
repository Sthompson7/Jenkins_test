pipeline {
    agent any

    stages {
        stage('checkout code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Sthompson7/Jenkins_test.git'
            }
        }

        stage('build') {
            steps {
                sh 'echo "building the app"'
            }
        }

        stage('test') {
            steps {
                sh 'echo "running tests"'
            }
        }

        stage('deploy') {
            steps {
                sh 'echo "deploying"'
            }
        }
    }

    post {
        success {
            sh 'echo "build successful"'
        }
        failure {
            sh 'echo "build failed"'
        }
    }
}
