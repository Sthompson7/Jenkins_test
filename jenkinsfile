pipeline {
    agent any
    environment{
      VENV = 'venv'
    }
    stages {
        stage('checkout'){
            steps {
                git branch: 'main',
                    url: 'https://github.com/Sthompson7/Jenkins_test.git'
            }
        }
      stage('set up VENV'){
       steps{
         bat 'python -m venv %VENV%'
         bat '%VENV%\\Scripts\\python -m pip install --upgrade pip'
         bat '%VENV%\\Scripts\\pip install -r requirments.txt'
        }
      }
      stage('Run the tests'){
        steps{
          bat '%VENV%\\Scripts\\python manage.py test'
      }
    }
  }
}

