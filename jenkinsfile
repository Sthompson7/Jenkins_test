pipeline {
    agent any
    environment {
      AWS_REGION = 'ap-south-1'
      IMAGE_NAME = 'Sthompson7/Jenkins_test'
      REPO_NAME = 'test 6'
    }
    stages {
        stage('checkout'){
            steps {
                git branch: 'main',
                    url: 'https://github.com/Sthompson7/Jenkins_test.git'
            }
        }

        stage('tag the image'){
            steps {
                scripts{
                  IMAGE_TAG = 'latest')
                 )
              }
         }

        stage('login to ECR') {
            steps {
              withAWS(region: "${env.AWS_REGION}", credentials: 'aws-creds'){
                powershell '''
                $ecrLogin = aws ecr get-login-password --region ${env.AWS_REGION}

                docker login --username AWS --password-stdin $ecrLogin https://897531648956.dkr.ecr.ap-south-1.amazonaws.com/test6
                '''
            }
          }
      }
      stage('build docker image){
       steps{
         powershell '''
         docker build -t $env.IMAGW_NAME:${env.IMAGE_TAG} .
         docker tag ${env.IMAGE_NAME}:${env.IMAGE_TAG} 897531648956.dkr.ecr.ap-south-1.amazonaws.com/test6
                '''
        }
      }
      stage('push to ECR'){
       steps{
         powershell '''
         docker push 897531648956.dkr.ecr.ap-south-1.amazonaws.com/test6:latest
         '''
      }
    }
  }

}

