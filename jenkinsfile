pipeline {
    agent any

    stages {
        stage('checkout code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Sthompson7/Jenkins_test.git'
            }
        }

        stage('build') {
            steps {
                bat 'echo "building the app"'
            }
        }

        stage('test') {
            steps {
                bat 'echo "running tests"'
            }
        }

        stage('deploy') {
            steps {
                bat 'echo "deploying"'
            }
        }
    }
}
post{
  success{
    bat 'echo "build successful"'
  }
  failure{
    bat 'echo "build failed"'
  }
}
